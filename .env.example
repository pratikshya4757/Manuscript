APP_NAME=Manuscript OCR Backend
APP_ENV=development
DEBUG=true

# Upload limits / security
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Storage
UPLOAD_DIR=uploads
PROCESSED_DIR=processed

# OCR
OCR_ENGINE=easyocr
OCR_LANGUAGES=en

# Kraken OCR (only used when OCR_ENGINE=kraken). Point this at a pretrained
# .mlmodel (e.g. downloaded via `kraken get <model-id>`) or your own
# fine-tuned model from `ketos train` — see training/README.md.
KRAKEN_MODEL_PATH=

# Language detection
LANGUAGE_DETECTION_ENGINE=langdetect
LANGUAGE_DETECTION_MIN_TEXT_LENGTH=20
LANGUAGE_DETECTION_LOW_CONFIDENCE_THRESHOLD=0.60

# Translation
TRANSLATION_PROVIDER=huggingface

# OCR quality thresholds
OCR_LOW_CONFIDENCE_THRESHOLD=0.60
OCR_MIN_TEXT_LENGTH=5

# Logging
LOG_LEVEL=INFO
